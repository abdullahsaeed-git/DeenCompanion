{
  "expo": {
    "name": "DeenCompanion_v1",
    "slug": "DeenCompanion_v1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/deenLogo/deenLogo.png",
    "scheme": "deencompanionv1",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8F6F0",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F6F0"
    },
    
    "ios": {
      "icon": "./assets/images/deenLogo/deenLogo.png", 
      "infoPlist": {
    "NSLocationWhenInUseUsageDescription": "We need your location to calculate accurate prayer times."
  }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F6F0",
        "foregroundImage": "./assets/images/deenLogo/deenLogo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.secrettechie.DeenCompanion_v1_android_dev", 
      "permissions": [
    "ACCESS_COARSE_LOCATION",
    "ACCESS_FINE_LOCATION"
  ]
    },
    "expo-status-bar": {
  "backgroundColor": "#F8F6F0",
  "barStyle": "dark-content",
  "translucent": false
},
    "web": {
      "output": "static",
      "favicon": "./assets/images/deenLogo/deenLogo-nobg.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F6F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c871e1a9-f590-4119-b0e3-21b747ff6ff5"
      }
    }
  }
}
